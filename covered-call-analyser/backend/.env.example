# =============================================================================
# .env.example — Environment variable template for local development
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
#
# For Render deployment, set these in the Render Environment dashboard
# (Settings → Environment → Add Environment Variable).
# =============================================================================

# --- ICICI Breeze API Credentials ---
# Obtain from: https://api.icicidirect.com/apiuser/login
#
# BREEZE_API_KEY and BREEZE_API_SECRET:
#   1. Log in to ICICI Direct developer portal at https://api.icicidirect.com
#   2. Register an application to receive your API Key and Secret.
#   3. These are permanent — store them safely.
#
# BREEZE_SESSION_TOKEN (REGENERATE EVERY MORNING):
#   The Breeze API uses a daily session token that expires at midnight.
#   To generate it each day:
#     a) Visit: https://api.icicidirect.com/apiuser/login
#     b) Log in with your ICICI Direct credentials + TOTP (Google Authenticator).
#     c) After login, you are redirected to:
#        https://<your-redirect-url>?apisession=<SESSION_TOKEN>
#     d) Copy the value after 'apisession=' — that is your BREEZE_SESSION_TOKEN.
#     e) Update this .env file (or call POST /refresh-session on Render).
#
BREEZE_API_KEY=your_breeze_api_key_here
BREEZE_API_SECRET=your_breeze_api_secret_here
BREEZE_SESSION_TOKEN=your_daily_session_token_here

# --- Charge Defaults (optional — these are the regulatory defaults) ---
DEFAULT_BROKERAGE=40.0       # Fixed brokerage per option leg in INR (Zerodha-style flat fee)
DEFAULT_STT_RATE=0.001       # STT = 0.1% on premium for options sold
DEFAULT_GST_RATE=0.18        # GST = 18% on brokerage

# --- Static IP Proxy (Phase 5 only — leave blank for local dev) ---
# If ICICI Breeze requires a whitelisted IP and you are on a dynamic IP,
# set up QuotaGuard Static on Render and paste the proxy URL here.
# QUOTAGUARDSTATIC_URL=http://your_quotaguard_user:password@proxy.quotaguard.com:9293

# --- Logging ---
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
